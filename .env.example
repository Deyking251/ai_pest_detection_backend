# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cropguard_db

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI Provider Routing
# Use groq, gemini, or leave blank for automatic provider order.
AI_PROVIDER=groq
AI_CHAT_PROVIDER=groq
AI_IMAGE_PROVIDER=groq

# Groq API Configuration
# Keep this key only on the backend. Do not put it in Flutter code.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google Gemini API Configuration
# Keep this key only on the backend. Do not put it in Flutter code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
ENABLE_SIMULATED_ANALYSIS=false

# Hugging Face API Configuration
# Get your free token at https://huggingface.co/settings/tokens
# Supported Crops: Rice, Wheat, Corn, Potato, Tomato, Banana, Mango, Papaya, Cauliflower, Guava, Cotton, Sugarcane, Tea, Jute
HF_API_TOKEN=your_huggingface_token_here

